// Hygiene Management System — Complete RBAC Inspection Platform
generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x: the Amazon Linux runtime used by Netlify functions
  // (build image differs from runtime, so ship both engines).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USERS & AUTH — 4 roles
// ============================================================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("INSPECTOR") // ADMIN | CEO | SUPERVISOR | INSPECTOR
  phone     String?
  active    Boolean  @default(true)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspectionsCreated   Inspection[]   @relation("InspectionCreator")
  inspectionsAssigned  Inspection[]   @relation("InspectionInspector")
  capasAssigned        CAPA[]         @relation("CapaAssignee")
  capasClosed          CAPA[]         @relation("CapaClosedBy")
  notifications        Notification[]
  messagesSent         Message[]      @relation("MessageSender")
  messagesReceived     Message[]      @relation("MessageRecipient")
  announcements        Announcement[]
  auditLogs            AuditLog[]
  inspectionHistory    InspectionHistory[]
  locationsSupervised  Location[]     @relation("LocationSupervisor")
}

// ============================================================
// LOCATIONS & FACILITIES
// ============================================================
model Location {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  address       String?
  city          String?
  gpsLat        Float?
  gpsLng        Float?
  facilityType  String   @default("OTHER") // HOTEL | RESTAURANT | HOSPITAL | OFFICE | FACTORY | KITCHEN | OTHER
  supervisorId  String?
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt     DateTime @default(now())

  supervisor     User?        @relation("LocationSupervisor", fields: [supervisorId], references: [id])
  inspections    Inspection[]
  capas          CAPA[]
  defects        Defect[]
  alerts         Alert[]
}

// ============================================================
// HYGIENE CATEGORIES & TEMPLATES
// ============================================================
model HygieneCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  items       TemplateItem[]
  capas       CAPA[]
  defects     Defect[]
}

model InspectionTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       TemplateItem[]
  inspections Inspection[]
}

model TemplateItem {
  id             String   @id @default(cuid())
  templateId     String
  categoryId     String
  question       String
  description    String?
  scoringMethod  String   @default("COMPLIANCE") // COMPLIANCE | SCORE | YES_NO
  weight         Float    @default(1.0)
  mandatory      Boolean  @default(true)
  photoRequired  Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  template   InspectionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  category   HygieneCategory    @relation(fields: [categoryId], references: [id])
  responses  InspectionItem[]
}

// ============================================================
// INSPECTIONS — Core entity with full workflow
// ============================================================
model Inspection {
  id               String    @id @default(cuid())
  templateId       String
  locationId       String
  inspectorId      String?
  createdById      String
  title            String
  scheduledDate    DateTime
  completedDate    DateTime?
  status           String    @default("PENDING") // PENDING | ASSIGNED | ACCEPTED | DECLINED | IN_PROGRESS | DRAFT | SUBMITTED | UNDER_REVIEW | RETURNED | APPROVED | CLOSED
  declineReason    String?
  reviewComments   String?
  correctionNotes  String?
  overallScore     Float?
  compliancePercent Float?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  template    InspectionTemplate  @relation(fields: [templateId], references: [id])
  location    Location            @relation(fields: [locationId], references: [id])
  inspector   User?               @relation("InspectionInspector", fields: [inspectorId], references: [id])
  createdBy   User                @relation("InspectionCreator", fields: [createdById], references: [id])
  items       InspectionItem[]
  history     InspectionHistory[]
  photos      InspectionPhoto[]
  capas       CAPA[]
  defects     Defect[]
  alerts      Alert[]

  @@index([inspectorId])
  @@index([locationId])
  @@index([status])
}

model InspectionItem {
  id                    String   @id @default(cuid())
  inspectionId          String
  templateItemId        String
  response              String? // COMPLIANT | PARTIALLY_COMPLIANT | NON_COMPLIANT | NOT_APPLICABLE
  score                 Float?
  comments              String?
  correctiveRecommendation String?
  severity              String? // CRITICAL | HIGH | MEDIUM | LOW
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  inspection     Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  templateItem   TemplateItem @relation(fields: [templateItemId], references: [id])
  photos         InspectionPhoto[]
}

model InspectionPhoto {
  id            String   @id @default(cuid())
  inspectionId  String
  itemId        String?
  imageUrl      String
  caption       String?
  type          String   @default("GENERAL") // BEFORE | AFTER | GENERAL | EVIDENCE
  isInternal    Boolean  @default(false) // internal photos excluded from client reports
  createdAt     DateTime @default(now())

  inspection Inspection       @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item       InspectionItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
}

model InspectionHistory {
  id            String   @id @default(cuid())
  inspectionId  String
  fromStatus    String?
  toStatus      String
  userId        String?
  comments      String?
  timestamp     DateTime @default(now())

  inspection Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id])
}

// ============================================================
// CAPA — Corrective and Preventive Actions
// ============================================================
model CAPA {
  id                 String    @id @default(cuid())
  inspectionId       String?
  locationId         String?
  categoryId         String?
  title              String
  description        String
  severity           String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  correctiveAction   String?
  assignedToId       String?
  targetDate         DateTime?
  status             String    @default("OPEN") // OPEN | ASSIGNED | IN_PROGRESS | SUBMITTED_FOR_VERIFICATION | CLOSED | CANCELLED | OVERDUE
  verificationComments String?
  closedById         String?
  closureDate        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  inspection   Inspection? @relation(fields: [inspectionId], references: [id])
  location     Location?   @relation(fields: [locationId], references: [id])
  category     HygieneCategory? @relation(fields: [categoryId], references: [id])
  assignedTo   User?       @relation("CapaAssignee", fields: [assignedToId], references: [id])
  closedBy     User?       @relation("CapaClosedBy", fields: [closedById], references: [id])
  evidence     CapaEvidence[]

  @@index([assignedToId])
  @@index([status])
}

model CapaEvidence {
  id        String   @id @default(cuid())
  capaId    String
  imageUrl  String
  caption   String?
  uploadedById String?
  createdAt DateTime @default(now())

  capa CAPA @relation(fields: [capaId], references: [id], onDelete: Cascade)
}

// ============================================================
// DEFECTS / NON-COMPLIANCE
// ============================================================
model Defect {
  id                 String    @id @default(cuid())
  inspectionId       String?
  locationId         String?
  categoryId         String?
  title              String
  description        String
  severity           String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  responsiblePerson  String?
  resolutionDeadline DateTime?
  status             String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | ESCALATED
  resolvedAt         DateTime?
  resolutionNotes    String?
  createdAt          DateTime  @default(now())

  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  category   HygieneCategory? @relation(fields: [categoryId], references: [id])

  @@index([status])
  @@index([severity])
}

// ============================================================
// ALERTS
// ============================================================
model Alert {
  id           String    @id @default(cuid())
  type         String    // CRITICAL_VIOLATION | LOW_SCORE | REPEATED_NON_COMPLIANCE | OVERDUE_CAPA | MISSED_INSPECTION | DECLINING_COMPLIANCE
  severity     String    @default("HIGH") // CRITICAL | HIGH | MEDIUM | LOW
  inspectionId String?
  locationId   String?
  title        String
  message      String
  status       String    @default("OPEN") // OPEN | RESOLVED
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  inspection Inspection? @relation(fields: [inspectionId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])

  @@index([status])
}

// ============================================================
// NOTIFICATIONS & MESSAGES
// ============================================================
model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String   // INSPECTION_ASSIGNED | TASK_ACCEPTED | INSPECTION_SUBMITTED | INSPECTION_APPROVED | INSPECTION_RETURNED | CAPA_ASSIGNED | ALERT | ANNOUNCEMENT | MESSAGE
  title      String
  message    String
  read       Boolean  @default(false)
  relatedId  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Message {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  subject     String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender   User @relation("MessageSender", fields: [fromUserId], references: [id])
  recipient User @relation("MessageRecipient", fields: [toUserId], references: [id])

  @@index([toUserId, read])
}

model Announcement {
  id         String   @id @default(cuid())
  createdById String
  title      String
  body       String
  audience   String   @default("ALL") // ALL | ADMIN | CEO | SUPERVISOR | INSPECTOR
  createdAt  DateTime @default(now())

  createdBy User @relation(fields: [createdById], references: [id])
}

// ============================================================
// AUDIT LOG — append-only
// ============================================================
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userRole   String?
  action     String   // CREATE | UPDATE | DELETE | STATUS_CHANGE | APPROVE | RETURN | ASSIGN | LOGIN | EXPORT
  entityType String   // Inspection | CAPA | Defect | User | Template | Location | etc.
  entityId   String?
  before     String?
  after      String?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================
model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
